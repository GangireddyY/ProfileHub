PORT=4000

# Sign-in sessions (httpOnly cookies). A session ends after SESSION_IDLE_DAYS without use and
# SESSION_MAX_DAYS after sign-in. SECURE_COOKIES defaults to true in production (HTTPS only).
SESSION_IDLE_DAYS=14
SESSION_MAX_DAYS=60
SECURE_COOKIES=

# Comma separated list of allowed frontend origins
CLIENT_ORIGIN=http://localhost:5173

# Default: SQLite file (zero setup). For production use Postgres or MySQL:
#   DATABASE_URL=postgres://user:pass@localhost:5432/profilehub   (npm i pg pg-hstore)
#   DATABASE_URL=mysql://user:pass@localhost:3306/profilehub      (npm i mysql2)
DB_STORAGE=./data/profilehub.sqlite
DATABASE_URL=

# PostgreSQL via separate settings (used when DB_NAME is set and DATABASE_URL is empty)
DB_NAME=
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_LOGGING=false

# Where uploaded profile and marketplace photos are stored
UPLOAD_DIR=./uploads

# Main admin account, created on startup if it doesn't exist yet. The password is only used for that
# first creation: afterwards the admin signs in and changes the password and profile from Settings,
# and ADMIN_PASSWORD can be removed. An existing member account with this email is never promoted.
ADMIN_NAME=ProfileHUB Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Public address of the web app, used in email and push links (defaults to the first CLIENT_ORIGIN)
APP_URL=

# Email (SendGrid). Without SENDGRID_API_KEY emails are printed to the backend console instead.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=ProfileHUB

# Browser/phone push notifications. Generate keys with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
