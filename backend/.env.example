PORT=4000
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Comma separated list of allowed frontend origins
CLIENT_ORIGIN=http://localhost:5173

# Default: SQLite file (zero setup). For production use Postgres or MySQL:
#   DATABASE_URL=postgres://user:pass@localhost:5432/profilehub   (npm i pg pg-hstore)
#   DATABASE_URL=mysql://user:pass@localhost:3306/profilehub      (npm i mysql2)
DB_STORAGE=./data/profilehub.sqlite
DATABASE_URL=

# PostgreSQL via separate settings (used when DB_NAME is set and DATABASE_URL is empty)
DB_NAME=
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_LOGGING=false

# Where uploaded profile and marketplace photos are stored
UPLOAD_DIR=./uploads

# Comma separated emails that get the admin role on startup (review profession requests, edit the catalog)
ADMIN_EMAILS=

# Main admin account, created on startup if it doesn't exist yet. The password is only used for that
# first creation: afterwards the admin signs in and changes the password and profile from Settings.
ADMIN_NAME=ProfileHUB Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
